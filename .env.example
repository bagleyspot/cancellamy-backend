# Copy to .env for local development. NEVER commit real values. In production use Secret Manager.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/cancellamy

# Secrets (generate: `openssl rand -base64 48` for JWT, `openssl rand -base64 32` for the encryption key)
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
DATA_ENCRYPTION_KEY=change-me-base64-of-32-random-bytes==

# Public URLs
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false

# Mail: dry-run records emails without sending them (default and safe). Use `resend` to really send.
MAIL_MODE=dry-run
MAIL_FROM=Cancellamy <richieste@example.org>
SUPPORT_EMAIL=supporto@example.org
INBOUND_DOMAIN=in.example.org
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Operator of this instance (appears in the delega and in the emails)
OPERATOR_NAME=Cancellamy (istanza di prova)
OPERATOR_ADDRESS=

# Limits
MAX_PROFILES_PER_USER=5
CUSTOM_REQUESTS_PER_MONTH=10
ADMIN_EMAILS=
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Resend Quota Guard & Fair Share Limits
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000
RESEND_SYSTEM_RESERVE=5
USER_DAILY_REQUEST_LIMIT=5

# Redis & BullMQ (staggered queue system for email requests)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
QUEUE_ENABLED=true

# Scheduler (on Cloud Run prefer Cloud Scheduler calling POST /internal/cron/tick with x-cron-secret)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
CRON_SECRET=

# Behaviour
RESPONSE_DEADLINE_DAYS=30
REMINDER_INTERVAL_DAYS=15
RENEWAL_DAYS=90
SEND_BATCH_SIZE=25
SEED_ON_BOOT=true
REGISTRY_PATH=registry/brokers.yaml
# Which brokers a new profile is contacted through: prioritize (relevant first, other markets last, unknown market never) | strict | off
BROKER_RELEVANCE=prioritize

# --- Optional capabilities. Everything below is OFF unless configured.
# Comma list to switch features off: sender, dossier, access, delisting, leaderboard, nuisance, breach
FEATURES_DISABLED=
# "Collega con Google": OAuth client (Google Cloud Console, Gmail API, scope gmail.send). Set both or none.
# Redirect URI to authorize in Google: <APP_URL>/app/collega-google (override with GOOGLE_OAUTH_REDIRECT_URI).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Breach check (Have I Been Pwned API key, paid). Without it the feature is hidden.
HAVEIBEENPWNED_API_KEY=
HIBP_USER_AGENT=Cancellamy
HIBP_REQUEST_INTERVAL_MS=6500
BREACH_RECHECK_DAYS=30
# SMS codes to verify phone numbers: none | dry-run (log only) | twilio
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Require verified phones for the identity level (default: true when an SMS provider is set)
IDENTITY_REQUIRE_PHONE=
# RFC 3161 timestamp authority for the evidence dossier (for example https://freetsa.org/tsr). Only a hash is sent.
TSA_URL=
# Public leaderboard: brokers appear only with this many distinct users
LEADERBOARD_MIN_USERS=20
# Incoming files (for example the data export of an access request) are kept encrypted this long
ATTACHMENT_RETENTION_DAYS=30
MAX_ATTACHMENT_BYTES=10485760
# Development/test only: allow SMTP hosts on private networks and any port
SMTP_ALLOW_PRIVATE_HOSTS=false
