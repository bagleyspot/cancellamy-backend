# Copy to `.env` in this folder (docker compose reads it). Never commit the real file.

# --- required secrets
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# openssl rand -base64 32   (BACK IT UP: without it stored personal data cannot be read)
DATA_ENCRYPTION_KEY=

# --- where the app is reached
APP_URL=http://localhost:8080
WEB_PORT=8080
# true when you serve it over HTTPS (recommended for anything public)
COOKIE_SECURE=false
# Repository that serves this code (AGPL-3.0 section 13), shown in the footer
SOURCE_URL=

# --- email: dry-run records emails without sending them
MAIL_MODE=dry-run
MAIL_FROM=Cancellamy <richieste@example.org>
INBOUND_DOMAIN=in.example.org
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
OPERATOR_NAME=Il tuo nome o la tua organizzazione
ADMIN_EMAILS=

# --- limits & queue
RESEND_DAILY_LIMIT=100
RESEND_MONTHLY_LIMIT=3000
RESEND_SYSTEM_RESERVE=5
USER_DAILY_REQUEST_LIMIT=5

# Redis & BullMQ (staggered request dispatching queue)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false
QUEUE_ENABLED=true

# --- optional capabilities (leave empty to keep them off)
# "Collega con Google" (Gmail API, scope gmail.send): set both or none. Authorized redirect URI: <APP_URL>/app/collega-google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
HAVEIBEENPWNED_API_KEY=
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TSA_URL=
# comma list of: sender,dossier,access,delisting,leaderboard,nuisance,breach
FEATURES_DISABLED=
LEADERBOARD_MIN_USERS=20
