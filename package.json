{
  "name": "cancellamy-backend",
  "version": "0.1.0",
  "description": "Cancellamy backend: free open-source GDPR data-removal service for Italy",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "verify:brokers": "nest build && node dist/brokers/verify-registry.cli.js",
    "openapi": "nest build && node dist/openapi.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "check:licenses": "license-checker-rseidelsohn --production --excludePackages \"cancellamy-backend@0.1.0\" --onlyAllow \"MIT;MIT-0;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;Python-2.0;PSF-2.0;(MIT AND Zlib);MIT*;BlueOak-1.0.0;CC0-1.0\" --summary"
  },
  "license": "AGPL-3.0-only",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "js-yaml": "^5.5.0",
    "mongoose": "^8.24.6",
    "multer": "^2.5.0",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.34.1",
    "rxjs": "^7.8.2",
    "standardwebhooks": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.10",
    "smtp-server": "^3.21.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
